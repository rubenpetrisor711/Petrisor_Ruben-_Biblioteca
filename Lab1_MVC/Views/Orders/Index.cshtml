@model IEnumerable<OrderListItem>

@{
    ViewData["Title"] = "Comenzi";
}

<h1>Comenzi</h1>

<p><a asp-action="Create">Comandă nouă</a></p>

<form asp-action="Index" method="get" class="mb-3">
    Cititor:
    <select name="customerId" asp-items='(SelectList)ViewData["CustomerID"]'>
        <option value="">Toți cititorii</option>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Filtrează</button>
    <a asp-action="Index">Toate comenzile</a>
</form>

<table class="table">
    <thead>
    <tr><th>Cititor</th><th>Carte</th><th>Data</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Customer</td>
            <td>@item.Book</td>
            <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.OrderID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.OrderID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.OrderID">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
